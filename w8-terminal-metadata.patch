+func (q *Queries) ListTerminalTaskMetadata(ctx context.Context, arg ListTerminalTaskMetadataParams) ([]ListTerminalTaskMetadataRow, error) {
+	rows, err := q.db.Query(ctx, listTerminalTaskMetadata,
+		arg.WorkspaceID,
+		arg.AfterCompletedAt,
+		arg.AfterID,
+		arg.WatermarkCompletedAt,
+		arg.WatermarkID,
+		arg.RowLimit,
+	)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []ListTerminalTaskMetadataRow{}
+	for rows.Next() {
+		var i ListTerminalTaskMetadataRow
+		if err := rows.Scan(
+			&i.Attempt,
+			&i.CompletedAt,
+			&i.CreatedAt,
+			&i.DispatchedAt,
+			&i.IsLeaderTask,
+			&i.IssueID,
+			&i.Kind,
+			&i.MaxAttempts,
+			&i.ParentTaskID,
+			&i.SourceID,
+			&i.StartedAt,
+			&i.Status,
+		); err != nil {
+			return nil, err
+		}
+		items = append(items, i)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
